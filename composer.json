{
    "name": "fastd/dobee-demo",
    "description": "Demo application package for the FastD dobee skeleton.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "FastD",
        "demo"
    ],
    "authors": [
        {
            "name": "JanHuang",
            "email": "bboyjanhuang@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "ext-json": "*",
        "fastd/fastd": "^8.2",
        "fastd/http": "^8.1",
        "fastd/cache": "^8.1",
        "fastd/medoodb": "^8.0",
        "fastd/swoole": "^8.1",
        "ext-pdo": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "swoole/ide-helper": "@dev"
    },
    "suggest": {
        "ext-swoole": "Swoole >= 6.0 is required by fastd/swoole for Swoole runtime demos (SSE and shared-memory sessions)",
        "ext-pdo_sqlite": "Required for the SQLite database demo"
    },
    "autoload": {
        "psr-4": {
            "FastD\\Demo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FastD\\Demo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
