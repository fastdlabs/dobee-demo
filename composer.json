{
    "name": "fastd/dobee-demo",
    "description": "Demo application package for FastD dobee skeleton",
    "type": "library",
    "license": "MIT",
    "keywords": ["FastD", "demo"],
    "authors": [
        {
            "name": "JanHuang",
            "email": "bboyjanhuang@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "ext-json": "*",
        "fastd/fastd": "^8.1",
        "fastd/http": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "swoole/ide-helper": "@dev"
    },
    "suggest": {
        "ext-swoole": "Required for Swoole runtime demos (SSE and shared-memory sessions)"
    },
    "autoload": {
        "psr-4": {
            "FastD\\Demo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FastD\\Demo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
